{
    "name": "hokoo/wp-hooks-dispatcher",
    "description": "Context-aware WordPress action and filter subscriptions",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/hokoo/wp-hooks-dispatcher",
    "keywords": [
        "hooks",
        "multisite",
        "wordpress"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "iTRON\\wpHooksDispatcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "iTRON\\wpHooksDispatcher\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "test": "phpunit",
        "test:integration": "phpunit --testsuite integration",
        "test:unit": "phpunit --testsuite unit",
        "check": [
            "@lint",
            "@analyse",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/hokoo/wp-hooks-dispatcher/issues",
        "source": "https://github.com/hokoo/wp-hooks-dispatcher"
    }
}
